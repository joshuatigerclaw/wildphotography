{
  "name": "wildphotography",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "turbo db:push",
    "db:generate": "turbo db:generate",
    "search:sync": "turbo search:sync",
    "pinterest:daily": "tsx scripts/pinterest/generate_daily_pinterest_queue.ts"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "tsx": "^4.22.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "dotenv": "^17.3.1",
    "got": "^14.6.6",
    "graceful-fs": "^4.2.11",
    "oauth-1.0a": "^2.2.6",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.3",
    "sharp": "^0.34.5",
    "typesense": "^3.0.2",
    "yet-another-react-lightbox": "^3.29.1"
  }
}
